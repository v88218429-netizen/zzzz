# Wildberries data source
# demo = built-in test cabinet; live = your real WB Seller API
WB_MODE=live
WB_API_TOKEN=
WB_SHOP_ID=

# Deterministic rules mode requires no OpenAI/Claude/Ollama API key.
LLM_PROVIDER=rules

# Optional Google Sheets read-only bridge
GOOGLE_SHEETS_BRIDGE_URL=
GOOGLE_SHEETS_BRIDGE_KEY=

# Optional Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

APP_HOST=127.0.0.1
APP_PORT=8787
APP_TIMEZONE=Europe/Moscow
DATA_DIR=./data
LOG_LEVEL=INFO

# Hard safety settings for this preview
OPERATION_MODE=shadow
AUTO_ACTIONS=false
FORCE_READ_ONLY=true
ENABLE_PUBLIC_WB_SEARCH=true

# Automatic safe updates
AUTO_UPDATE_ENABLED=true
AUTO_UPDATE_MANIFEST_URL=https://raw.githubusercontent.com/v88218429-netizen/zzzz/mainggg/wb_ai_manager/update-manifest.json
AUTO_UPDATE_CHANNEL=stable
AUTO_UPDATE_CHECK_SECONDS=60

# Geo destination used only by unofficial public WB storefront search.
PUBLIC_WB_DEST=-1257786
